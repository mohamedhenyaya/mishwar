{
  "expo": {
    "name": "Mishwar Capitaine",
    "slug": "CapitainApp",
    "version": "3.2.65",
    "orientation": "portrait",
    "scheme": "mishwarcapitaine",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nous utilisons votre position pour recevoir les courses à proximité.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Nous utilisons votre position en arrière-plan pour suivre votre trajet en cours."
      }
    },
    "android": {
      "package": "com.mishwar.capitaine",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_ANDROID_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Nous utilisons votre position pour recevoir et effectuer les courses.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nous accédons à vos photos pour votre photo de profil et les documents de votre dossier.",
          "cameraPermission": "Nous utilisons l’appareil photo pour votre photo de profil et les documents de votre dossier."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/new_ride.wav"]
        }
      ],
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5FF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
