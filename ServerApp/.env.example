PORT=3000
NODE_ENV=development

# PostgreSQL — en local : variables séparées ; sur Railway : DATABASE_URL suffit
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL=false
# DB_SYNCHRONIZE=true   # production : crée/met à jour les tables (pas encore de migrations)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=mishwar

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Twilio WhatsApp (laisser SID/TOKEN vides pour utiliser le fallback console en dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+22220122724

# Google Places Autocomplete (recherche de lieux)
GOOGLE_PLACES_API_KEY=

# Dossier des photos envoyées (production : volume persistant, ex. /data/uploads)
# UPLOADS_DIR=

# Secret à usage unique pour créer le tout premier compte admin via POST /auth/admin/bootstrap
ADMIN_BOOTSTRAP_SECRET=

# Push Firebase (écran « Nouvelle course » app capitaine fermée) — l’un ou l’autre :
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   (contenu JSON, ex. Railway)
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/chemin/vers/cle-firebase-adminsdk.json   (en local)
