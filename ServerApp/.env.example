PORT=3000
NODE_ENV=development

# PostgreSQL / PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=vtc_user
DB_PASSWORD=vtc_password
DB_NAME=vtc_db

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Twilio WhatsApp (laisser SID/TOKEN vides pour utiliser le fallback console en dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+22220122724

# Google Places Autocomplete (recherche de lieux)
GOOGLE_PLACES_API_KEY=

# Secret à usage unique pour créer le tout premier compte admin via POST /auth/admin/bootstrap
ADMIN_BOOTSTRAP_SECRET=
